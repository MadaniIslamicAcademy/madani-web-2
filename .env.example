# Shared
ENVIRONMENT=development
APP_NAME=Madani Social Automation Platform
TIMEZONE=Asia/Karachi
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Database and queue
DATABASE_URL=postgresql+psycopg://madani:madani@db:5432/madani_social
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@madaniislamicacademy.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password-now

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_PROVIDER=openai

# Publishing
SOCIAL_PUBLISH_MODE=mock
MAX_PUBLISH_RETRIES=3

# Meta and WhatsApp
META_GRAPH_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/meta/callback
WHATSAPP_VERIFY_TOKEN=change-whatsapp-verify-token

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/oauth/linkedin/callback
LINKEDIN_VERSION=202607

# Google and YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/oauth/tiktok/callback

# X
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/oauth/x/callback
